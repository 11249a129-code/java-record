import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JPanel;
import java.awt.CardLayout;
import java.awt.FlowLayout;

public class CardLayoutDemo {
public static void main(String[] args) {
JFrame frame = new JFrame("CardLayout Example");
CardLayout cardLayout = new CardLayout();
JPanel cards = new JPanel(cardLayout);
JPanel first = new JPanel();
first.add(new JButton("This is Card 1"));
JPanel second = new JPanel();
second.add(new JButton("This is Card 2"));
cards.add(first, "First");
cards.add(second, "Second");
JButton next = new JButton("Next");
JButton previous = new JButton("Previous");
JPanel controls = new JPanel(new FlowLayout());
controls.add(previous);
controls.add(next);
next.addActionListener(e -> cardLayout.next(cards));
previous.addActionListener(e -> cardLayout.previous(cards));
frame.add(cards, "Center");
frame.add(controls, "South");
frame.setSize(350, 200);
frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
frame.setLocationRelativeTo(null);
frame.setVisible(true);
}
}
